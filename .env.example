# The Isle: Evrima RCON client
# Copy this file to .env and fill in values.
# Never commit .env.

# Remote game host (panel Network & Ports). Game UDP is :7777; RCON is :2456.
# If Node runs ON the game machine, use 127.0.0.1 instead of the public IP.
RCON_HOST=51.79.187.73
RCON_PORT=2456
RCON_PASSWORD=change-me
RCON_TIMEOUT=8000

# Auto reconnect
RCON_RECONNECT=true
RCON_RECONNECT_DELAY=1000
RCON_RECONNECT_MAX_DELAY=30000
RCON_RECONNECT_MULTIPLIER=2
RCON_RECONNECT_MAX_ATTEMPTS=0

# Player monitor (polls playerlist)
PLAYER_MONITOR_ENABLED=false
PLAYER_POLL_INTERVAL=5000

# Logging (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info
LOG_PRETTY=false

# systemd unit name for The Isle dedicated server
SYSTEMD_UNIT=theisle

# Leave empty when the game is on another host (Start/Stop/Game.ini will not work)
SERVER_DIR=
STEAMCMD_PATH=/usr/games/steamcmd

# Optional copy of TheIsle/Saved/Database/TheIslePersistence.db (often encrypted)
# ISLE_PERSISTENCE_DB=src/db/TheIslePersistence.db

# Web admin + /play.html (0.0.0.0 = reachable from outside)
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=3123
WEB_USERNAME=admin
WEB_PASSWORD=change-me-too
WEB_SESSION_TTL_MS=86400000
WEB_RATE_LIMIT_MAX=120
WEB_RATE_LIMIT_WINDOW_MS=60000
WEB_LOGIN_RATE_LIMIT_MAX=8
