# The Isle: Evrima RCON client
# Copy this file to .env and fill in values.
# Never commit .env.

# RCON listens locally on the VPS. Do not expose port 8888 to the Internet.
RCON_HOST=127.0.0.1
RCON_PORT=8888
RCON_PASSWORD=change-me
RCON_TIMEOUT=5000

# Auto reconnect
RCON_RECONNECT=true
RCON_RECONNECT_DELAY=1000
RCON_RECONNECT_MAX_DELAY=30000
RCON_RECONNECT_MULTIPLIER=2
RCON_RECONNECT_MAX_ATTEMPTS=0

# Player monitor (polls playerlist)
PLAYER_MONITOR_ENABLED=false
PLAYER_POLL_INTERVAL=5000

# Logging (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info
LOG_PRETTY=true

# systemd unit name for The Isle dedicated server
SYSTEMD_UNIT=theisle

# Game install root (TheIsle/Saved/Config/LinuxServer/Game.ini lives under this)
# Required for Game.ini editor, backups, SteamCMD, chat log, post-restart scripts
SERVER_DIR=/home/steam/TheIsleDedicatedServer
STEAMCMD_PATH=/usr/games/steamcmd

# Web admin panel (bind local by default; put nginx/SSH tunnel in front)
WEB_ENABLED=true
WEB_HOST=127.0.0.1
WEB_PORT=3123
WEB_USERNAME=admin
WEB_PASSWORD=change-me-too
WEB_SESSION_TTL_MS=86400000
WEB_RATE_LIMIT_MAX=120
WEB_RATE_LIMIT_WINDOW_MS=60000
WEB_LOGIN_RATE_LIMIT_MAX=8
