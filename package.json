{
  "name": "evrima-rcon",
  "version": "1.0.0",
  "description": "RCON client/manager for The Isle: Evrima dedicated servers",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "evrima-rcon": "./dist/cli/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "web": "node dist/index.js",
    "cli": "node dist/cli/cli.js",
    "read-db": "tsx src/cli/readPersistence.ts",
    "dev": "tsx src/cli/cli.ts",
    "dev:web": "tsx src/index.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart evrima-rcon",
    "pm2:stop": "pm2 stop evrima-rcon",
    "pm2:logs": "pm2 logs evrima-rcon",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "keywords": [
    "the-isle",
    "evrima",
    "rcon",
    "game-server"
  ],
  "license": "MIT",
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.0",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
